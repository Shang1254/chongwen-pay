/* 首页样式：简约蓝白物业风 */

/* 加载骨架屏 */
.sk {
  background: #E6EDF5;
  border-radius: 16rpx;
  animation: sk-pulse 1.1s ease-in-out infinite alternate;
}
.sk-banner { height: 180rpx; margin: 24rpx; border-radius: 0 0 32rpx 32rpx; }
.sk-card { height: 220rpx; margin: 28rpx 24rpx 0; }
.sk-line { height: 44rpx; margin: 20rpx 24rpx 0; }
.sk-line.short { width: 45%; }
@keyframes sk-pulse {
  from { opacity: 0.55; }
  to { opacity: 1; }
}

.page {
  padding-bottom: 60rpx;
}

.banner {
  background: linear-gradient(135deg, #2B6CB0, #3E85D0);
  color: #ffffff;
  padding: 48rpx 32rpx 56rpx;
  border-radius: 0 0 32rpx 32rpx;
}
.banner-title {
  font-size: 52rpx;
  font-weight: 700;
}
.banner-sub {
  font-size: 32rpx;
  margin-top: 10rpx;
  opacity: 0.95;
}

/* 试点测试入口卡片 */
.test-card {
  border-left: 10rpx solid #E67E22;
  background: #FFF9F0;
}
.test-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}
.test-icon {
  font-size: 52rpx;
  margin-right: 18rpx;
}
.test-info {
  flex: 1;
}
.test-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #8A4B00;
}
.test-tip {
  font-size: 30rpx;
  color: #7A5A2E;
  line-height: 1.6;
  margin-top: 4rpx;
}
.test-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 36rpx;
}

.center-card {
  text-align: center;
  margin-top: 32rpx;
}
.big-emoji {
  font-size: 100rpx;
  margin-bottom: 16rpx;
}
.center-card .btn-primary {
  margin-top: 32rpx;
  width: 80%;
}

/* 多房产切换标签 */
.hh-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 24rpx 24rpx 0;
}
.hh-pill {
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 3rpx solid #C5D4E8;
  color: #5C6B7A;
  border-radius: 40rpx;
  padding: 12rpx 28rpx;
  font-size: 32rpx;
}
.hh-pill.on {
  background: #2B6CB0;
  border-color: #2B6CB0;
  color: #ffffff;
  font-weight: 700;
}
.hh-role {
  font-size: 24rpx;
  background: #E67E22;
  color: #ffffff;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-left: 10rpx;
}
.hh-pill.on .hh-role {
  background: #ffffff;
  color: #E67E22;
}

/* 水电物业费大卡片 */
.home-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  margin: 28rpx 24rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(43, 108, 176, 0.1);
  border-left: 12rpx solid #3E85D0;
}
.home-card-head {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.home-emoji {
  font-size: 52rpx;
  margin-right: 16rpx;
}
.home-card-name {
  font-size: 44rpx;
  font-weight: 600;
}
.home-card-tip {
  font-size: 32rpx;
  color: #5C6B7A;
  margin-top: 4rpx;
}

.pay-all {
  margin: 40rpx 24rpx 0;
  width: calc(100% - 48rpx);
}

.row-btns {
  display: flex;
  margin: 28rpx 24rpx 0;
  gap: 24rpx;
}
.half {
  flex: 1;
}
.full {
  flex: 1;
}

.footer-tip {
  text-align: center;
  font-size: 30rpx;
  color: #8FA0B5;
  margin-top: 48rpx;
}
