/* 绑定户号页样式：蓝白物业风 */
.step-line {
  font-size: 38rpx;
  font-weight: 700;
  color: #2B6CB0;
  margin-bottom: 20rpx;
}
.step-line.mt {
  margin-top: 40rpx;
}

.form-row {
  margin-bottom: 24rpx;
}

.mini-tip {
  font-size: 28rpx;
  color: #8FA0B5;
  line-height: 1.6;
  margin: -8rpx 0 8rpx;
}

/* 身份选择 */
.role-chips {
  display: flex;
  gap: 24rpx;
}
.role-chip {
  flex: 1;
  text-align: center;
  background: #F1F5FB;
  border: 3rpx solid #C5D4E8;
  color: #5C6B7A;
  border-radius: 16rpx;
  padding: 24rpx 0;
  font-size: 38rpx;
  font-weight: 600;
}
.role-chip.on {
  background: #2B6CB0;
  border-color: #2B6CB0;
  color: #ffffff;
}

.ph {
  color: #A8B4C4;
}

.submit-btn {
  margin-top: 32rpx;
  width: 100%;
}

.tip-card {
  border-left: 10rpx solid #3E85D0;
}
.tip-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.tip-line {
  font-size: 32rpx;
  color: #5C6B7A;
  line-height: 1.8;
}
