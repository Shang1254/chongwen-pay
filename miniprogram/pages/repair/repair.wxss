/* 报修页样式：蓝白物业风 */
.mt { margin-top: 28rpx; }
.form-row { margin-bottom: 24rpx; }

.picker-box {
  background: #F1F5FB;
  border: 2rpx solid #C5D4E8;
  border-radius: 16rpx;
  height: 100rpx;
  line-height: 100rpx;
  padding: 0 28rpx;
  font-size: 38rpx;
  color: #1B2735;
}

.textarea-big {
  width: 100%;
  min-height: 200rpx;
  background: #F1F5FB;
  border: 2rpx solid #C5D4E8;
  border-radius: 16rpx;
  padding: 20rpx 28rpx;
  font-size: 36rpx;
  box-sizing: border-box;
}

.submit-btn {
  width: 100%;
  margin-top: 8rpx;
}

/* 现场照片 */
.img-row { display: flex; align-items: center; gap: 20rpx; }
.img-add {
  width: 160rpx; height: 160rpx;
  background: #F1F5FB;
  border: 3rpx dashed #C5D4E8;
  border-radius: 16rpx;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  color: #5C6B7A; font-size: 40rpx;
}
.img-add text { font-size: 24rpx; margin-top: 6rpx; }
.repair-img { width: 160rpx; height: 160rpx; border-radius: 16rpx; }
.img-del { font-size: 26rpx; color: #C62828; }
.repair-thumb { width: 120rpx; height: 120rpx; border-radius: 12rpx; margin-top: 10rpx; }

.repair-item {
  border-top: 2rpx solid #EDF2F8;
  padding: 24rpx 0;
}
.repair-item:first-of-type { border-top: none; }
.repair-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.repair-cat {
  font-size: 38rpx;
  font-weight: 600;
}
.repair-content {
  font-size: 34rpx;
  margin-top: 8rpx;
  color: #1B2735;
}
.repair-meta {
  font-size: 28rpx;
  color: #8FA0B5;
  margin-top: 8rpx;
}
.repair-feedback {
  background: #F1F5FB;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  font-size: 30rpx;
  color: #1E4E8C;
  margin-top: 12rpx;
}
