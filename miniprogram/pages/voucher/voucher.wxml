<view class="page">
  <view class="card" wx:if="{{loading}}"><view class="empty-tip">正在生成凭证…</view></view>

  <view class="card" wx:if="{{!loading && error}}">
    <view class="empty-tip">{{error}}</view>
  </view>

  <block wx:if="{{v}}">
    <view class="receipt">
      <!-- 凭证抬头 -->
      <view class="receipt-head">
        <view class="receipt-title">电子缴费凭证</view>
        <view class="receipt-sub">{{v.community}} · {{v.company}}</view>
      </view>

      <view class="receipt-divider"></view>

      <view class="receipt-row"><text class="k">凭证编号</text><text class="val">{{v.voucherNo}}</text></view>
      <view class="receipt-row"><text class="k">房号</text><text class="val">{{v.houseLabel}}</text></view>
      <view class="receipt-row"><text class="k">户主</text><text class="val">{{v.ownerMasked}}</text></view>

      <view class="receipt-divider"></view>

      <!-- 费用明细 -->
      <view class="item-row" wx:for="{{v.items}}" wx:key="period">
        <view class="item-left">
          <view class="item-name">{{item.typeLabel}}（{{item.period}}）</view>
          <view class="item-meta" wx:if="{{item.type !== 'property'}}">用量 {{item.usage}} × ¥{{item.unitPrice}}</view>
          <view class="item-meta" wx:else>按物业服务合同收取</view>
        </view>
        <view class="item-amount">¥{{item.amountText}}</view>
      </view>

      <view class="total-row">
        <text>合计</text>
        <text class="total-amount">¥{{v.amountText}}</text>
      </view>

      <view class="receipt-divider"></view>

      <view class="receipt-row"><text class="k">缴费时间</text><text class="val">{{v.paidAt}}</text></view>
      <view class="receipt-row"><text class="k">收款方</text><text class="val">{{v.company}}</text></view>
      <view class="receipt-row"><text class="k">收款渠道</text><text class="val">{{v.channel}}</text></view>
      <view class="receipt-row" wx:if="{{v.transactionId}}"><text class="k">交易单号</text><text class="val small">{{v.transactionId}}</text></view>

      <!-- 防伪码 -->
      <view class="verify-box">
        <view class="verify-label">防伪码（可向物业口头核对）</view>
        <view class="verify-code">{{v.verifyCode}}</view>
      </view>

      <view class="receipt-note">{{v.priceNotice}}</view>
      <view class="receipt-note">{{v.note}}</view>
    </view>

    <button class="btn-primary save-btn" bindtap="saveTip">📷 截图保存凭证</button>
  </block>
</view>
