/* 电子凭证样式：像一张正式的收费收据 */
.receipt {
  background: #ffffff;
  border-radius: 20rpx;
  margin: 24rpx;
  padding: 0 0 32rpx;
  box-shadow: 0 6rpx 24rpx rgba(43, 108, 176, 0.12);
  overflow: hidden;
}

.receipt-head {
  background: linear-gradient(135deg, #2B6CB0, #3E85D0);
  color: #ffffff;
  padding: 36rpx 32rpx;
  text-align: center;
}
.receipt-title {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}
.receipt-sub {
  font-size: 28rpx;
  margin-top: 8rpx;
  opacity: 0.95;
}

.receipt-divider {
  border-top: 2rpx dashed #DCE7F5;
  margin: 24rpx 32rpx;
}

.receipt-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 32rpx;
  font-size: 32rpx;
}
.receipt-row .k {
  color: #8FA0B5;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.receipt-row .val {
  text-align: right;
  color: #1B2735;
  font-weight: 500;
  word-break: break-all;
}
.receipt-row .val.small {
  font-size: 26rpx;
  font-weight: 400;
}

.item-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 32rpx;
}
.item-name {
  font-size: 34rpx;
  font-weight: 600;
}
.item-meta {
  font-size: 28rpx;
  color: #8FA0B5;
  margin-top: 4rpx;
}
.item-amount {
  font-size: 36rpx;
  font-weight: 700;
  color: #1E4E8C;
}

.total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 32rpx 0;
  font-size: 38rpx;
  font-weight: 600;
}
.total-amount {
  font-size: 52rpx;
  font-weight: 700;
  color: #1E4E8C;
}

.verify-box {
  margin: 24rpx 32rpx 0;
  background: #F1F5FB;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
}
.verify-label {
  font-size: 28rpx;
  color: #5C6B7A;
}
.verify-code {
  font-size: 56rpx;
  font-weight: 800;
  color: #2B6CB0;
  letter-spacing: 8rpx;
  margin-top: 8rpx;
}

.receipt-note {
  font-size: 28rpx;
  color: #8FA0B5;
  line-height: 1.7;
  padding: 8rpx 32rpx 0;
}

.save-btn {
  margin: 8rpx 24rpx 40rpx;
  width: calc(100% - 48rpx);
}
