/* 我的户号页样式：蓝白物业风 */
.room-emoji {
  font-size: 90rpx;
  text-align: center;
}
.room-label {
  font-size: 48rpx;
  font-weight: 700;
  text-align: center;
  margin-top: 8rpx;
}
.room-owner {
  font-size: 36rpx;
  color: #5C6B7A;
  text-align: center;
  margin-top: 8rpx;
}
.room-account {
  background: #F1F5FB;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 28rpx;
  font-size: 34rpx;
  color: #1E4E8C;
  line-height: 1.9;
}

.mt {
  margin-top: 28rpx;
  width: 100%;
}

.btn-danger {
  background: #ffffff;
  color: #C62828;
  border: 3rpx solid #C62828;
  font-size: 38rpx;
  font-weight: 600;
  border-radius: 52rpx;
  height: 96rpx;
  line-height: 96rpx;
}
.btn-danger::after {
  border: none;
}

.price-card {
  border-left: 10rpx solid #3E85D0;
}
/* 多房产列表 */
.hh-item {
  border-top: 2rpx solid #EDF2F8;
  padding: 24rpx 0;
}
.hh-item:first-of-type { border-top: none; }
.hh-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.hh-room {
  font-size: 40rpx;
  font-weight: 700;
}
.hh-sub {
  font-size: 30rpx;
  color: #5C6B7A;
  margin-top: 6rpx;
}
.hh-ops {
  display: flex;
  gap: 16rpx;
  margin-top: 14rpx;
}
.mini-btn {
  font-size: 28rpx !important;
  padding: 0 24rpx !important;
  line-height: 56rpx !important;
  background: #2B6CB0 !important;
  color: #ffffff !important;
  border-radius: 28rpx !important;
}
.mini-btn.ghost {
  background: #ffffff !important;
  color: #C62828 !important;
  border: 2rpx solid #C62828 !important;
}

.price-card {
  border-left: 10rpx solid #3E85D0;
}
.about-title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.about-line {
  font-size: 32rpx;
  color: #5C6B7A;
  line-height: 1.9;
}
