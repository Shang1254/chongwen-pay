/* 缴费结果页样式 */
.result-card {
  text-align: center;
  margin-top: 60rpx;
}
.result-emoji {
  font-size: 120rpx;
}
.result-title {
  font-size: 52rpx;
  font-weight: 700;
  margin: 16rpx 0 8rpx;
}
.result-tip {
  font-size: 32rpx;
  color: #5C6B7A;
  margin-top: 12rpx;
}
.result-notice {
  font-size: 28rpx;
  color: #2B6CB0;
  background: #E8F0FA;
  border-radius: 10rpx;
  padding: 10rpx 16rpx;
  margin-top: 20rpx;
  display: inline-block;
}
.back-btn {
  margin: 24rpx 24rpx 0;
  width: calc(100% - 48rpx);
}
