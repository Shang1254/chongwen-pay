/* 缴费确认页样式：蓝白物业风 */
.pay-room {
  background: #E8F0FA;
  color: #1E4E8C;
  font-size: 30rpx;
  padding: 14rpx 24rpx;
  margin: 16rpx 24rpx 0;
  border-radius: 12rpx;
  font-weight: 600;
}
.list-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 28rpx 32rpx 8rpx;
}
.list-title {
  font-size: 40rpx;
  font-weight: 600;
}
.select-all {
  font-size: 34rpx;
  color: #2B6CB0;
  font-weight: 600;
}

.bill-item {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 20rpx 24rpx;
  display: flex;
  align-items: center;
  border: 3rpx solid #DCE7F5;
}
.bill-item.on {
  border-color: #2B6CB0;
  background: #F3F8FE;
}

.check-dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 3rpx solid #B8C4D4;
  margin-right: 24rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #ffffff;
  font-weight: 700;
  box-sizing: border-box;
}
.bill-item.on .check-dot {
  background: #2B6CB0;
  border-color: #2B6CB0;
}

.bill-info {
  flex: 1;
}
.bill-name {
  font-size: 38rpx;
  font-weight: 600;
}
.bill-meta {
  font-size: 30rpx;
  color: #5C6B7A;
  margin-top: 6rpx;
}
.bill-meta.red {
  color: #C62828;
  font-weight: 600;
}
.bill-amount {
  font-size: 44rpx;
  font-weight: 700;
  color: #1E4E8C;
  margin-left: 16rpx;
}

/* 零加价提示 */
.price-note {
  background: #E8F0FA;
  color: #1E4E8C;
  font-size: 28rpx;
  line-height: 1.6;
  margin: 20rpx 24rpx 180rpx;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
}

/* 底部结算栏 */
.pay-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.pay-total-label {
  font-size: 30rpx;
  color: #5C6B7A;
}
.pay-btn {
  width: 300rpx;
  margin: 0;
}
