<view class="page">
  <!-- 多房产时必须看清缴的是哪套房 -->
  <view class="pay-room" wx:if="{{roomLabel}}">📌 当前房号：{{roomLabel}}</view>

  <view class="card" wx:if="{{loading}}"><view class="empty-tip">正在读取账单…</view></view>

  <block wx:if="{{!loading}}">
    <!-- 没有待缴账单 -->
    <view class="card" wx:if="{{bills.length === 0}}">
      <view class="empty-tip">🎉 暂无待缴账单，您家的水电费都交清啦</view>
    </view>

    <block wx:else>
      <view class="list-head">
        <view class="list-title">待缴账单（共 {{bills.length}} 笔）</view>
        <view class="select-all" bindtap="toggleAll">全选/取消</view>
      </view>

      <!-- 账单卡片：点一下勾选/取消 -->
      <view class="bill-item {{b.checked ? 'on' : ''}}" wx:for="{{bills}}" wx:key="id"
            data-id="{{item.id}}" bindtap="toggle">
        <view class="check-dot">{{item.checked ? '✓' : ''}}</view>
        <view class="bill-info">
          <view class="bill-name">{{item.emoji}} {{item.label}}（{{item.period}}）</view>
          <view class="bill-meta">用量 {{item.usage}}，{{item.dueDate}} 前缴清</view>
          <view class="bill-meta red" wx:if="{{item.overdueDays > 0}}">已逾期 {{item.overdueDays}} 天</view>
        </view>
        <view class="bill-amount">¥{{item.amount}}</view>
      </view>

      <!-- 零加价公示 -->
      <view class="price-note">💡 水电费按武汉水务、国网湖北电力官方定价代收，物业零加价，缴费后可查看电子凭证。</view>

      <!-- 底部结算栏 -->
      <view class="pay-bar">
        <view class="pay-total">
          <view class="pay-total-label">合计（{{count}} 笔）</view>
          <view class="big-amount">¥{{total}}</view>
        </view>
        <button class="btn-primary pay-btn" bindtap="submit" disabled="{{paying || count === 0}}">
          {{paying ? '正在支付…' : '微信支付'}}
        </button>
      </view>
    </block>
  </block>
</view>
